{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playonline",
  "compatibility_date": "2026-05-10",
  "observability": {
    "enabled": true
  },
  "dir": "frontend/dist",
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS"
  },
  "site": {
    "bucket": "frontend/dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
